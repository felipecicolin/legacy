<%# locals: (needs:, visibility:, empty_title:, empty_description:) %>
<% if needs.any? %>
  <div class="mt-3 grid gap-4 tablet:grid-cols-2 desktop:grid-cols-3">
    <% needs.each do |need| %>
      <%= render CardComponent.new(variant: "outlined") do %>
        <a class="font-medium text-foreground hover:text-primary" href="<%= need_path(need) %>">
          <%= need.title %>
        </a>
        <p class="mt-1 text-label text-muted-foreground">
          <%= need.need_kind_label %> · <%= need.urgency_label %>
        </p>
        <p class="text-label text-muted-foreground">
          <%= need.ngo.location_label(visibility) %>
          <% if need.needed_by %> · <%= t(".by_date", date: l(need.needed_by)) %><% end %>
        </p>
        <p class="mt-2 font-mono text-label text-foreground">
          <%= t(".remaining", done: need.fulfilled_quantity, total: need.quantity) %>
        </p>
        <%# O requisito aparece ANTES da tentativa: quem não tem registro
            verificado precisa saber que é isso que trava, e não descobrir por
            erro de formulário depois de escrever a motivação. %>
        <% if need.requires_professional_registration? %>
          <p class="mt-2 text-label text-warning"><%= t(".requires_credential") %></p>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= render EmptyStateComponent.new(icon: "search", title: empty_title,
                                     description: empty_description, classes: "mt-3") %>
<% end %>
