<%# locals: (deployments:) %>
<% if deployments.any? %>
  <section class="mt-8">
    <h2 class="text-lg font-semibold text-foreground"><%= t(".title") %></h2>
    <div class="mt-3 grid gap-4 tablet:grid-cols-2 desktop:grid-cols-3">
      <% deployments.each do |deployment| %>
        <%= render CardComponent.new(variant: "outlined") do %>
          <p class="font-medium text-foreground"><%= deployment.name %></p>
          <p class="text-label text-muted-foreground">
            <%= l(deployment.departs_on) %> — <%= l(deployment.returns_on) %>
          </p>
          <% if deployment.seats_left %>
            <p class="mt-2 font-mono text-label text-foreground">
              <%= t(".seats_left", count: deployment.seats_left) %>
            </p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
