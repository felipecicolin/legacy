<h1 class="text-display text-foreground"><%= t(".title") %></h1>
<p class="mt-2 text-body text-muted-foreground"><%= t(".help") %></p>

<%= form_with url: password_path(params[:token]), method: :put, class: "contents" do |form| %>
  <div class="mt-8 flex flex-col gap-5">
    <div>
      <%= form.label :password, t(".password"), class: "text-sm font-semibold text-foreground" %>
      <%= form.password_field :password, required: true, maxlength: 72, autofocus: true,
                              autocomplete: "new-password",
                              class: auth_field_classes %>
    </div>

    <div>
      <%= form.label :password_confirmation, t(".confirmation"), class: "text-sm font-semibold text-foreground" %>
      <%= form.password_field :password_confirmation, required: true, maxlength: 72,
                              autocomplete: "new-password",
                              class: auth_field_classes %>
    </div>

    <%= render ButtonComponent.new(label: t(".submit"), type: :submit, size: :lg, classes: "mt-1 w-full") %>
  </div>
<% end %>
