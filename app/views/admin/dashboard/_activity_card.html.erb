<%= render CardComponent.new(variant: "default") do %>
  <div class="flex items-center justify-between gap-2">
    <span class="text-body text-foreground"><%= report.project.title %></span>

    <span class="font-mono text-label text-muted-foreground">
      <%= number_to_percentage(report.physical_progress, precision: 0) %>
    </span>
  </div>

  <p class="text-label text-muted-foreground"><%= report.caption %></p>
<% end %>
