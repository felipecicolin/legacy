<%= render CardComponent.new(variant: "outlined") do %>
  <% photo = project.cover_photo %>

  <% if photo %>
    <%= render ImageFrameComponent.new(attachment: photo.image, alt: "") do |frame| %>
      <% frame.with_caption { photo.caption } %>
    <% end %>
  <% end %>

  <div class="mt-3 flex items-center justify-between gap-2">
    <span class="font-mono text-label text-muted-foreground"><%= project.code %></span>
    <%= render StatusBadgeComponent.new(status: project.status, size: :sm) %>
  </div>

  <p class="mt-1 text-section text-foreground"><%= project.title %></p>
  <p class="text-label text-muted-foreground"><%= project.mission_base.name %></p>

  <div class="mt-3">
    <%= render ProgressBarComponent.new(kind: "physical", value: project.physical_progress) %>
  </div>
<% end %>
