<%= render PageHeaderComponent.new(title: t(".title"), subtitle: t(".subtitle")) %>

<% if dashboard.investor? %>
  <dl class="mt-6 grid gap-4 tablet:grid-cols-3">
    <%= render StatCardComponent.new(label: t(".invested"),
                                     value: money_from_cents(dashboard.invested_cents)) %>
    <%= render StatCardComponent.new(label: t(".active_projects"),
                                     value: number_with_delimiter(dashboard.active_count)) %>
    <%= render StatCardComponent.new(label: t(".people_reached"),
                                     value: number_with_delimiter(dashboard.people_reached),
                                     hint: t(".per_year")) %>
  </dl>

  <%# ROI social. Duas das três medidas saem EXATAS do que existe; a terceira é
      projeção, e o horizonte dela vai impresso ao lado do número — projeção com
      a premissa escondida é chute com aparência de dado. %>
  <section class="mt-8">
    <h2 class="text-section text-foreground"><%= t(".roi_title") %></h2>
    <p class="mt-1 text-body text-muted-foreground"><%= t(".roi_subtitle") %></p>

    <dl class="mt-4 grid gap-4 tablet:grid-cols-3">
      <%= render StatCardComponent.new(
            label: t(".multiplier"),
            value: dashboard.people_per_base ? number_with_delimiter(dashboard.people_per_base) : t(".no_multiplier"),
            hint: t(".per_base", amount: money_from_cents(InvestorDashboard::MULTIPLIER_BASE_CENTS)),
          ) %>
      <%= render StatCardComponent.new(
            label: t(".cost_per_person"),
            value: dashboard.cost_per_person_cents ? money_from_cents(dashboard.cost_per_person_cents) : t(".no_multiplier"),
            hint: t(".cost_per_person_hint"),
          ) %>
      <%= render StatCardComponent.new(
            label: t(".projected_reach"),
            value: number_with_delimiter(dashboard.projected_reach),
            hint: t(".projected_reach_hint", years: InvestorDashboard::PROJECTION_YEARS),
          ) %>
    </dl>
  </section>

  <section class="mt-8">
    <h2 class="text-section text-foreground"><%= t(".projects_title") %></h2>

    <% if dashboard.active_stakes.any? %>
      <%= render TableComponent.new(rows: dashboard.active_stakes, caption: t(".projects_caption"),
                                    classes: "mt-3") do |table| %>
        <% table.with_column(header: t(".code")) do |stake| %>
          <span class="tabular-nums"><%= stake.project.code %></span>
        <% end %>
        <%# A obra é o destino natural desta linha: quem financia quer ver o
            que a fatia dele virou. %>
        <% table.with_column(header: t(".project")) do |stake| %>
          <%= link_to stake.project.title, project_path(stake.project.code),
                      class: "font-medium text-foreground underline-offset-4 hover:underline" %>
        <% end %>
        <% table.with_column(header: t(".ngo")) { |stake| stake.project.ngo.name } %>
        <% table.with_column(header: t(".status")) do |stake| %>
          <%= render StatusBadgeComponent.new(status: stake.project.status, size: :sm) %>
        <% end %>
        <% table.with_column(header: t(".contributed"), align: :right) do |stake| %>
          <%= money_from_cents(stake.contributed_cents) %>
        <% end %>
        <% table.with_column(header: t(".reach"), align: :right) do |stake| %>
          <%= number_with_delimiter(stake.attributed_reach) %>
        <% end %>
      <% end %>
    <% else %>
      <%= render EmptyStateComponent.new(icon: "hard-hat", title: t(".no_projects_title"),
                                         description: t(".no_projects_description"), classes: "mt-3") %>
    <% end %>

    <%# O agregado anonimizado que substitui a obra que este leitor não alcança:
        a prestação de contas continua, e a obra não vira alvo. %>
    <% if dashboard.hidden_disclosable? %>
      <p class="mt-3 text-body text-muted-foreground">
        <%= t(".hidden_aggregate", count: dashboard.hidden.project_count,
                                   amount: money_from_cents(dashboard.hidden.contributed_cents),
                                   reach: number_with_delimiter(dashboard.hidden.attributed_reach)) %>
      </p>
    <% end %>

    <%# Número menor sem explicação se lê como número errado. %>
    <% if dashboard.hidden_withheld? %>
      <p class="mt-3 text-body text-muted-foreground"><%= t(".hidden_withheld") %></p>
    <% end %>

    <% if dashboard.unlinked_cents.positive? %>
      <p class="mt-3 text-body text-muted-foreground">
        <%= t(".unlinked", amount: money_from_cents(dashboard.unlinked_cents)) %>
      </p>
    <% end %>
  </section>
<% else %>
  <%# Quem entrou e ainda não aportou não tem painel para ver. Uma tela de
      zeros se lê como erro de cálculo; dizer que ainda não há aporte, não. %>
  <%= render EmptyStateComponent.new(icon: "wallet", title: t(".empty_title"),
                                     description: t(".empty_description"), classes: "mt-6") %>
<% end %>
