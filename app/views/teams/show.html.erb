<%= render PageHeaderComponent.new(title: t(".title"), subtitle: t(".subtitle")) %>

<% if dashboard.on_a_team? %>
  <div class="mt-6 space-y-4">
    <% dashboard.boards.each do |board| %>
      <%= render CardComponent.new(class: "p-5") do %>
        <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
          <div class="min-w-0">
            <%# Metadado antes do título, e menor: quem varre a lista procura o
                nome da obra, não o código dela. %>
            <p class="text-sm text-muted-foreground">
              <span class="tabular-nums"><%= board.project.code %></span>
              · <%= board.project.ngo.name %> · <%= board.role %>
            </p>
            <h2 class="text-section text-foreground"><%= board.project.title %></h2>
          </div>
          <%= render StatusBadgeComponent.new(status: board.project.status, size: :sm) %>
        </div>

        <dl class="mt-5 grid gap-4 tablet:grid-cols-3">
          <div>
            <dt class="text-sm font-medium text-muted-foreground"><%= t(".planned_start") %></dt>
            <dd class="mt-0.5 text-foreground tabular-nums">
              <%= board.project.planned_start_on ? l(board.project.planned_start_on) : t(".undefined") %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-muted-foreground"><%= t(".actual_start") %></dt>
            <dd class="mt-0.5 text-foreground tabular-nums">
              <%= board.project.actual_start_on ? l(board.project.actual_start_on) : t(".not_started") %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-muted-foreground"><%= t(".delivery") %></dt>
            <dd class="mt-0.5 font-semibold text-foreground tabular-nums">
              <%= board.project.planned_end_on ? l(board.project.planned_end_on) : t(".undefined") %>
            </dd>
          </div>
        </dl>

        <%# As três barras juntas e separadas do resto por uma divisória: elas
            respondem a mesma pergunta — quanto de quanto — e lê-las lado a
            lado é o que mostra prazo, gasto e caixa desalinhados. %>
        <div class="mt-5 space-y-5 border-t border-border pt-5">
          <%= render ProgressBarComponent.new(kind: "physical", value: board.project.physical_progress) %>
          <%# Duas colunas e não três: o par valor/meta é uma linha longa, e em
              um terço da largura ele quebra no meio do número. %>
          <div class="grid gap-5 tablet:grid-cols-2">
            <%# O componente recebe REAIS, não centavos. %>
            <%= render ProgressBarComponent.new(kind: "spending", value: board.spent_cents / 100.0,
                                                target: board.budgeted_cents / 100.0) %>
            <%= render ProgressBarComponent.new(kind: "funding", value: board.raised_cents / 100.0,
                                                target: board.goal_cents / 100.0) %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= render EmptyStateComponent.new(icon: "hard-hat", title: t(".empty_title"),
                                     description: t(".empty_description"), classes: "mt-6") %>
<% end %>
