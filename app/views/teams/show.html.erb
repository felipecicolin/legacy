<%= render PageHeaderComponent.new(title: t(".title"), subtitle: t(".subtitle")) %>

<% if dashboard.on_a_team? %>
  <div class="mt-6 grid gap-4 desktop:grid-cols-2">
    <% dashboard.boards.each do |board| %>
      <%= render CardComponent.new(class: "flex flex-col gap-5 p-5") do %>
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="truncate text-sm text-muted-foreground">
              <span class="tabular-nums"><%= board.project.code %></span>
              · <%= board.project.ngo.name %> · <%= board.role %>
            </p>
            <h2 class="mt-0.5 text-section text-foreground">
              <%= link_to board.project.title, project_path(board.project.code),
                          class: "underline-offset-4 hover:underline" %>
            </h2>
          </div>
          <%= render StatusBadgeComponent.new(status: board.project.status, size: :sm) %>
        </div>

        <%# Uma métrica principal, e não três iguais: o avanço é o que responde
            "como vai a obra". O resto é contexto dela. %>
        <div>
          <div class="flex items-baseline justify-between gap-3">
            <span class="text-sm font-medium text-muted-foreground"><%= t(".progress") %></span>
            <span class="text-2xl font-semibold tracking-tight text-foreground tabular-nums">
              <%= number_to_percentage(board.project.physical_progress, precision: 0) %>
            </span>
          </div>
          <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-muted">
            <div class="h-full rounded-full bg-primary"
                 style="width: <%= board.project.physical_progress %>%"></div>
          </div>
        </div>

        <%# Três medidas compactas: cada uma um número curto e um traço fino.
            Barra cheia com par valor/meta por extenso, três vezes por cartão,
            vira ruído — o olho para de distinguir qual é qual. %>
        <dl class="mt-auto grid grid-cols-3 gap-4 border-t border-border pt-4">
          <div class="min-w-0">
            <dt class="text-sm font-medium text-muted-foreground"><%= t(".delivery") %></dt>
            <dd class="mt-1 truncate font-semibold text-foreground tabular-nums">
              <%= board.project.planned_end_on ? l(board.project.planned_end_on) : t(".undefined") %>
            </dd>
            <% if board.project.planned_end_on %>
              <dd class="text-sm text-muted-foreground">
                <%= t(".in_time", time: distance_of_time_in_words(Date.current, board.project.planned_end_on)) %>
              </dd>
            <% end %>
          </div>

          <% [[t(".budget"), board.spent_cents, board.budgeted_cents, "bg-warning"],
              [t(".raised"), board.raised_cents, board.goal_cents, "bg-accent"]].each do |label, value, target, tone| %>
            <div class="min-w-0">
              <dt class="text-sm font-medium text-muted-foreground"><%= label %></dt>
              <dd class="mt-1 font-semibold text-foreground tabular-nums">
                <%= number_to_percentage(share_percentage(value, target), precision: 0) %>
              </dd>
              <%# Só o absoluto: o percentual logo acima já diz a razão, e
                  repetir "de R$ Y" só produz truncamento. %>
              <dd class="truncate text-sm text-muted-foreground tabular-nums">
                <%= money_rounded_from_cents(value) %>
              </dd>
              <dd class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <span class="block h-full rounded-full <%= tone %>"
                      style="width: <%= share_percentage(value, target) %>%"></span>
              </dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= render EmptyStateComponent.new(icon: "hard-hat", title: t(".empty_title"),
                                     description: t(".empty_description"), classes: "mt-6") %>
<% end %>
