<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="bg-background text-foreground">
    <%# "Sair" é ação, não destino: ícone no canto da barra. O nome acessível
        vai no `aria-label` e num `sr-only` — botão só de ícone sem nome é
        inacessível, e é o erro mais comum de barra enxuta. %>
    <% if authenticated? %>
      <% content_for :shell_header_actions do %>
        <%= render ButtonComponent.new(variant: :ghost, size: :icon, href: session_path,
                                       aria: { label: t("layouts.application.sign_out") },
                                       data: { turbo_method: :delete }) do %>
          <%= render IconComponent.new(name: "arrow-right", size: :sm) %>
          <span class="sr-only"><%= t("layouts.application.sign_out") %></span>
        <% end %>
      <% end %>
    <% end %>

    <%= render AppShellComponent.new do |shell| %>
      <% if authenticated? %>
        <% shell.with_navigation do %>
          <%# Ícone MAIS rótulo, nunca só ícone: navegação sem texto custa
              descoberta. E o item atual fica marcado — coluna sem estado ativo
              é lista de links sem contexto. Os quatro últimos ainda não têm
              destino, e a opacidade menor diz isso antes do clique. %>
          <% [[:investor, investor_path, "wallet"], [:team, team_path, "hard-hat"],
              [:ngos, "#", "building"], [:projects, "#", "blueprint"],
              [:campaigns, "#", "hand-heart"], [:search, "#", "search"]].each do |key, path, icon| %>
            <% here = path != "#" && current_page?(path) %>
            <%= render ButtonComponent.new(
                  variant: :ghost, size: :sm, href: path,
                  aria: { current: ("page" if here) },
                  classes: class_names(
                    "w-full justify-start gap-3 text-accent-foreground hover:bg-accent-foreground/10",
                    "bg-accent-foreground/15 font-semibold" => here,
                    "opacity-75" => path == "#",
                  ),
                ) do %>
              <%= render IconComponent.new(name: icon, size: :sm) %>
              <span><%= t(key, scope: "layouts.application.nav") %></span>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <% if authenticated? && Current.user.profile %>
        <% shell.with_footer do %>
          <div class="flex items-center gap-3">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary
                         text-sm font-semibold text-primary-foreground"
                  aria-hidden="true"><%= Current.user.profile.display_name.first %></span>
            <span class="min-w-0">
              <span class="block truncate font-medium"><%= Current.user.profile.display_name %></span>
              <span class="block truncate text-sm opacity-80">
                <%= Current.user.email_address %>
              </span>
            </span>
          </div>
        <% end %>
      <% end %>
      <%= render "shared/flash" %>
      <%= yield %>
    <% end %>
  </body>
</html>
