<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Legacy">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# O build do Tailwind (app/assets/builds/tailwind.css). Sem esta linha a
        página sobe sem nenhuma utility: `:app` resolve para
        app/assets/stylesheets/application.css, que é só manifesto. %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-background text-foreground">
    <%# Cabeçalho mínimo: sair precisa existir em toda página autenticada, não
        só na de chegada. #8 troca isto pelo shell de verdade. %>
    <% if authenticated? %>
      <header class="border-b border-border">
        <nav class="container mx-auto flex items-center justify-end px-5 py-3">
          <%= render ButtonComponent.new(label: t("layouts.application.sign_out"), variant: :ghost,
                                         size: :sm, href: session_path,
                                         data: { turbo_method: :delete }) %>
        </nav>
      </header>
    <% end %>

    <main class="container mx-auto mt-28 flex px-5">
      <%= yield %>
    </main>
  </body>
</html>
