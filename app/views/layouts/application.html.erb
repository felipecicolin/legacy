<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Legacy">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# O build do Tailwind (app/assets/builds/tailwind.css). Sem esta linha a
        página sobe sem nenhuma utility: `:app` resolve para
        app/assets/stylesheets/application.css, que é só manifesto. %>
    <%# O actiontext.css entra ANTES do tailwind: as duas folhas trazem regra
        sem camada para `trix-editor`, e sem camada quem vence é a ordem. As
        sobreposições com token do projeto estão em app/assets/tailwind/. %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-background text-foreground">
    <%# No layout, e não na tela de arrecadação: assim toda tela nasce marcada
        e nenhuma precisa lembrar. O componente decide sozinho se aparece —
        pergunta ao provedor de pagamento, não ao ambiente. %>
    <%= render SimulatedDataBannerComponent.new(classes: "mx-auto mt-4 w-full max-w-7xl px-4 tablet:px-5 desktop:px-6") %>

    <%= render AppShellComponent.new do |shell| %>
      <% if authenticated? %>
        <% shell.with_navigation do %>
          <%= render ButtonComponent.new(label: t("layouts.application.sign_out"), variant: :ghost,
                                         size: :sm, href: session_path, classes: "w-full justify-start",
                                         data: { turbo_method: :delete }) %>
        <% end %>
      <% end %>
      <%= render "shared/flash" %>
      <%= yield %>
    <% end %>
  </body>
</html>
