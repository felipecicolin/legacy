<h1 class="text-display text-foreground"><%= t(".title") %></h1>
<p class="mt-2 text-body text-muted-foreground"><%= t(".subtitle") %></p>

<%= form_with url: session_url, class: "contents" do |form| %>
  <div class="mt-8 flex flex-col gap-5">
    <div>
      <%= form.label :email_address, t(".email"), class: "text-sm font-semibold text-foreground" %>
      <%= form.email_field :email_address, required: true, autofocus: true,
                           autocomplete: "username", value: params[:email_address],
                           class: auth_field_classes %>
    </div>

    <div>
      <div class="flex items-baseline justify-between gap-4">
        <%= form.label :password, t(".password"), class: "text-sm font-semibold text-foreground" %>
        <%= link_to t(".forgot"), new_password_path,
                    class: "text-sm text-primary underline-offset-4 hover:underline" %>
      </div>
      <%# maxlength 72 porque o bcrypt trunca em 72 bytes: sem o limite, o
          usuário digitaria uma senha maior achando que ela conta inteira. %>
      <%= form.password_field :password, required: true, maxlength: 72,
                              autocomplete: "current-password",
                              class: auth_field_classes %>
    </div>

    <%= render ButtonComponent.new(label: t(".submit"), type: :submit, size: :lg, classes: "mt-1 w-full") %>
  </div>
<% end %>
