<%# locals: (records:, view_mode:) %>
<% if records.any? %>
  <section class="mt-8">
    <h2 class="text-lg font-semibold text-foreground"><%= t(".title", count: records.size) %></h2>
    <% if view_mode == "table" %>
      <%= render TableComponent.new(rows: records, caption: t(".caption"), classes: "mt-3") do |table| %>
        <% table.with_column(header: t(".code")) { |project| project.code } %>
        <% table.with_column(header: t(".name")) { |project| project.title } %>
        <% table.with_column(header: t(".base")) { |project| project.mission_base.name } %>
        <% table.with_column(header: t(".status")) do |project| %>
          <%= render StatusBadgeComponent.new(status: project.status, size: :sm) %>
        <% end %>
      <% end %>
    <% else %>
      <div class="mt-3 grid gap-4 tablet:grid-cols-2 desktop:grid-cols-3">
        <% records.each do |project| %>
          <%= render CardComponent.new(variant: "outlined") do %>
            <p class="font-mono text-label text-muted-foreground"><%= project.code %></p>
            <p class="mt-1 font-medium text-foreground"><%= project.title %></p>
            <p class="text-label text-muted-foreground"><%= project.mission_base.name %></p>
            <div class="mt-3"><%= render StatusBadgeComponent.new(status: project.status, size: :sm) %></div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>
