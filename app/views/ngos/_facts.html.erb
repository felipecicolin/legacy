<%# locals: (ngo:, presenter:) %>
<dl class="mt-3 grid grid-cols-2 gap-3 tablet:grid-cols-4">
  <div>
    <dt class="text-label text-muted-foreground"><%= t(".kind") %></dt>
    <dd class="text-foreground"><%= ngo.ngo_kind_label %></dd>
  </div>
  <div>
    <dt class="text-label text-muted-foreground"><%= t(".status") %></dt>
    <dd class="text-foreground"><%= ngo.ngo_status_label %></dd>
  </div>
  <% if ngo.established_on %>
    <div>
      <dt class="text-label text-muted-foreground"><%= t(".established") %></dt>
      <dd class="text-foreground"><%= l(ngo.established_on, format: :long) %></dd>
    </div>
  <% end %>
  <% if ngo.people_served %>
    <div>
      <dt class="text-label text-muted-foreground"><%= t(".people_served") %></dt>
      <dd class="font-mono text-foreground"><%= number_with_delimiter(ngo.people_served) %></dd>
    </div>
  <% end %>
  <%# A coordenada só existe no HTML para quem alcança o registro. Quem não
      alcança não recebe o elemento vazio: recebe elemento nenhum. %>
  <% if presenter.precise_location %>
    <div>
      <dt class="text-label text-muted-foreground"><%= t(".coordinates") %></dt>
      <dd class="font-mono text-foreground"><%= presenter.precise_location.join(", ") %></dd>
    </div>
  <% end %>
</dl>
