<div class="col-span-full min-w-0">
  <%# O código já está na trilha logo abaixo: repetir "Obra OB-0001" acima
      dela era a mesma informação duas vezes, com dois estilos. %>
  <div class="mb-2 flex justify-end">
    <%= render StatusBadgeComponent.new(status: presenter.status) %>
  </div>

  <%= render PageHeaderComponent.new(title: presenter.title, subtitle: presenter.location) do |header| %>
    <% header.with_breadcrumb(label: t(".breadcrumb"), href: projects_path) %>
    <% header.with_breadcrumb(label: presenter.code) %>
  <% end %>

  <%# Três abas, não cinco: com uma seção por aba a maioria delas cabia
      numa frase, e a barra virava índice de páginas quase vazias. Cada
      aba responde uma pergunta inteira — como vai, quem está, quanto custou. %>
  <div class="mt-6 min-w-0" data-controller="project-tabs">
    <div role="tablist" aria-label="<%= t(".section_navigation") %>"
         class="flex gap-6 overflow-x-auto border-b border-border">
      <button type="button" role="tab" data-project-tabs-target="tab"
              data-action="project-tabs#select"
              class="shrink-0 border-b-2 border-transparent px-1 pb-3 text-body font-medium
                     text-muted-foreground transition-colors hover:text-foreground
                     aria-selected:border-primary aria-selected:font-semibold aria-selected:text-foreground">
        <%= t(".navigation.progress") %>
      </button>
      <button type="button" role="tab" data-project-tabs-target="tab"
              data-action="project-tabs#select"
              class="shrink-0 border-b-2 border-transparent px-1 pb-3 text-body font-medium
                     text-muted-foreground transition-colors hover:text-foreground
                     aria-selected:border-primary aria-selected:font-semibold aria-selected:text-foreground">
        <%= t(".navigation.people") %>
      </button>
      <button type="button" role="tab" data-project-tabs-target="tab"
              data-action="project-tabs#select"
              class="shrink-0 border-b-2 border-transparent px-1 pb-3 text-body font-medium
                     text-muted-foreground transition-colors hover:text-foreground
                     aria-selected:border-primary aria-selected:font-semibold aria-selected:text-foreground">
        <%= t(".navigation.funding") %>
      </button>
    </div>

    <div class="mt-8 min-w-0">
    <section role="tabpanel" data-project-tabs-target="panel" hidden
             aria-label="<%= t(".navigation.progress") %>" class="min-w-0 space-y-8">
      <section class="min-w-0">
        <h2 class="mb-4 text-section text-foreground"><%= t(".progress.title") %></h2>
        <div class="mt-5 grid gap-6 tablet:grid-cols-2">
          <div class="min-w-0">
            <%= render ProgressBarComponent.new(kind: "physical", value: presenter.physical_progress) %>
            <p class="mt-3 text-sm text-muted-foreground">
              <% if presenter.progress_report %>
                <%= t(".progress.reported", date: l(presenter.progress_report.reported_on),
                      author: presenter.report_author(presenter.progress_report,
                                                       role_label: t(".reports.reporter"))) %>
              <% else %>
                <%= t(".progress.direct") %>
              <% end %>
            </p>
          </div>

          <div class="min-w-0" data-simulated="true">
            <%= render ProgressBarComponent.new(kind: "funding", value: presenter.funding_value / 100.0,
                                                 target: presenter.funding_target / 100.0) %>
            <p class="mt-3 text-sm text-muted-foreground">
              <%= t(".progress.goal", value: number_to_currency(presenter.funding_target / 100.0)) %>
            </p>
            <p class="mt-1 text-sm font-medium text-warning"><%= t(".simulated") %></p>
          </div>
        </div>

        <p class="mt-5 text-body text-muted-foreground">
          <% if presenter.stages.empty? %>
            <%= t(".phases.direct", value: number_to_percentage(presenter.physical_progress, precision: 0)) %>
          <% else %>
            <%= t(".phases.weighted", value: number_to_percentage(presenter.physical_progress, precision: 0)) %>
          <% end %>
        </p>
        <% unless presenter.stages.empty? %>
          <%# Uma barra segmentada, e não quatro soltas: a contribuição de cada
              etapa SOMA o total ponderado logo acima, e barras separadas
              escondiam justamente essa relação. Os tons vêm de `category-*`,
              que é o vocabulário de "qual coisa é esta" — nunca o de estado. %>
          <% tones = %w[bg-category-1 bg-category-2 bg-category-3 bg-category-4] %>
          <div class="mt-4 flex h-3 w-full overflow-hidden rounded-full bg-muted">
            <% presenter.stages.each_with_index do |stage, position| %>
              <span class="block h-full <%= tones[position % tones.size] %>"
                    style="width: <%= presenter.phase_contribution(stage) %>%"></span>
            <% end %>
          </div>

          <dl class="mt-5 grid gap-x-8 gap-y-4 tablet:grid-cols-2">
            <% presenter.stages.each_with_index do |stage, position| %>
              <div class="min-w-0">
                <div class="flex items-baseline gap-2">
                  <span class="size-2.5 shrink-0 rounded-full <%= tones[position % tones.size] %>"
                        aria-hidden="true"></span>
                  <dt class="min-w-0 flex-1 truncate text-body font-medium text-foreground">
                    <%= stage.name %>
                  </dt>
                  <dd class="shrink-0 text-body font-semibold text-foreground tabular-nums">
                    <%= number_to_percentage(stage.physical_progress, precision: 0) %>
                  </dd>
                </div>
                <dd class="ml-4 text-sm text-muted-foreground">
                  <%= t(".phases.weight", weight: stage.weight,
                         contribution: number_to_percentage(presenter.phase_contribution(stage), precision: 1)) %>
                </dd>
              </div>
            <% end %>
          </dl>
        <% end %>
      </section>

      <section class="min-w-0 border-t border-border pt-8">
        <h2 class="mb-4 text-section text-foreground"><%= t(".reports.title") %></h2>
        <%= helpers.turbo_frame_tag "project-reports" do %>
          <% if presenter.reports.empty? %>
            <p class="mt-5 text-body text-muted-foreground"><%= t(".reports.empty") %></p>
          <% else %>
            <ol class="mt-5 space-y-8 border-l-2 border-border pl-5">
              <% presenter.reports.each do |report| %>
                <li class="relative min-w-0">
                  <%# O ponto cobre a espessura do trilho, senão ele aparece
                      atravessando a bolinha. %>
                  <span class="absolute -left-6 top-1.5 size-2.5 rounded-full bg-primary ring-4 ring-card"
                        aria-hidden="true"></span>
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                    <div class="flex items-baseline gap-3">
                      <time class="text-sm font-medium text-foreground tabular-nums"
                            datetime="<%= report.reported_on.iso8601 %>">
                        <%= l(report.reported_on) %>
                      </time>
                      <%# O percentual de cada entrada é o que transforma uma
                          lista de textos em linha do tempo de execução. %>
                      <span class="rounded-full bg-primary-soft px-2 py-0.5 text-xs font-semibold
                                   text-primary tabular-nums">
                        <%= number_to_percentage(report.physical_progress, precision: 0) %>
                      </span>
                      <% if report.workers_on_site %>
                        <span class="text-sm text-muted-foreground tabular-nums">
                          <%= t(".reports.workers", count: report.workers_on_site) %>
                        </span>
                      <% end %>
                    </div>
                    <span class="text-sm text-muted-foreground">
                      <%= t(".reports.by", name: presenter.report_author(report,
                                                                         role_label: t(".reports.reporter"))) %>
                    </span>
                  </div>
                  <p class="mt-3 text-body text-foreground">
                    <%= report.summary.to_plain_text.presence || t(".reports.no_summary") %>
                  </p>
                  <% if report.blockers.to_plain_text.presence %>
                    <p class="mt-2 rounded-sm bg-warning-soft px-3 py-2 text-sm text-warning">
                      <span class="font-semibold"><%= t(".reports.blockers") %></span>
                      <%= report.blockers.to_plain_text %>
                    </p>
                  <% end %>
                  <% if report.project_photos.any? %>
                    <div class="mt-4 grid min-w-0 gap-4 tablet:grid-cols-2">
                      <% report.project_photos.each do |photo| %>
                        <%= render ImageFrameComponent.new(
                              attachment: photo.image,
                              alt: photo.caption.presence || t(".reports.photo_alt"),
                              ratio: "16/9",
                            ) do |frame| %>
                          <% frame.with_caption { presenter.photo_caption(photo) } %>
                        <% end %>
                      <% end %>
                    </div>
                  <% end %>
                </li>
              <% end %>
            </ol>
            <% if presenter.more_reports? %>
              <div class="mt-6">
                <%= render ButtonComponent.new(label: t(".reports.load_more"), variant: :outline, size: :sm,
                                               href: helpers.project_path(presenter.code,
                                                                  reports_page: presenter.next_reports_page),
                                               data: { turbo_frame: "project-reports" }) %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </section>
    </section>

    <section role="tabpanel" data-project-tabs-target="panel" hidden
             aria-label="<%= t(".navigation.people") %>" class="min-w-0 space-y-8">
      <section class="min-w-0">
        <h2 class="mb-4 text-section text-foreground"><%= t(".team.title") %></h2>
        <% if presenter.team_members.empty? %>
          <p class="text-body text-muted-foreground"><%= t(".team.empty") %></p>
        <% else %>
          <%# Duas colunas com o papel EMBAIXO do nome: em linha cheia o papel
              ficava a mil pixels da pessoa, e o olho precisava atravessar a
              tela para juntar os dois. %>
          <ul class="grid gap-x-8 gap-y-3 tablet:grid-cols-2">
            <% presenter.team_members.each do |member| %>
              <li class="flex min-w-0 items-center gap-3 rounded-lg border border-border bg-card p-3">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-muted
                             text-sm font-semibold text-foreground"
                      aria-hidden="true"><%= presenter.member_name(member).first %></span>
                <span class="min-w-0">
                  <span class="block truncate text-body font-medium text-foreground">
                    <%= presenter.member_name(member) %>
                  </span>
                  <span class="block truncate text-sm text-muted-foreground">
                    <%= member.participation_role_label %>
                  </span>
                </span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </section>

      <section class="min-w-0 border-t border-border pt-8">
        <h2 class="mb-4 text-section text-foreground"><%= t(".needs.title") %></h2>
        <% if presenter.needs.empty? %>
          <p class="text-body text-muted-foreground"><%= t(".needs.empty") %></p>
        <% else %>
          <%# Duas colunas: o cartão tinha três linhas curtas ocupando a largura
              inteira. E o que falta vira número em destaque — é o dado que
              decide se alguém age. %>
          <ul class="grid gap-4 tablet:grid-cols-2">
            <% presenter.needs.each do |need| %>
              <li class="flex min-w-0 flex-col gap-4 rounded-lg border border-border bg-card p-4">
                <div class="flex min-w-0 items-start justify-between gap-4">
                  <div class="min-w-0">
                    <h3 class="text-body font-semibold text-foreground"><%= need.title %></h3>
                    <p class="mt-1 text-sm text-muted-foreground"><%= need.need_kind_label %></p>
                  </div>
                  <div class="shrink-0 text-right">
                    <p class="text-2xl font-semibold tracking-tight text-foreground tabular-nums">
                      <%= number_with_delimiter(need.remaining_quantity) %>
                    </p>
                    <p class="text-sm text-muted-foreground tabular-nums">
                      <%= t(".needs.remaining", remaining: need.remaining_quantity, total: need.quantity) %>
                    </p>
                  </div>
                </div>
                <% if need.served_by_person? %>
                  <div class="mt-auto">
                    <%= render ButtonComponent.new(label: t(".needs.apply"), variant: :soft, size: :sm,
                                                   href: helpers.new_need_candidacy_path(need)) %>
                  </div>
                <% end %>
            <% end %>
          </ul>
        <% end %>
      </section>
    </section>

    <section role="tabpanel" data-project-tabs-target="panel" hidden
             aria-label="<%= t(".navigation.funding") %>" class="min-w-0 space-y-8">
      <section class="min-w-0">
        <h2 class="mb-4 text-section text-foreground"><%= t(".budget.title") %></h2>
        <% if presenter.budget_rows.empty? %>
          <p class="mt-5 text-body text-muted-foreground"><%= t(".budget.empty") %></p>
        <% else %>
          <div class="mt-5 min-w-0">
            <%= render TableComponent.new(rows: presenter.budget_rows, caption: t(".budget.caption")) do |table| %>
              <% table.with_column(header: t(".budget.item")) { |row| row.description } %>
              <% table.with_column(header: t(".budget.category")) { |row| row.category } %>
              <% table.with_column(header: t(".budget.estimated"), align: :right) do |row| %>
                <%= number_to_currency(row.estimated_cents / 100.0) %>
              <% end %>
              <% table.with_column(header: t(".budget.spent"), align: :right) do |row| %>
                <%= number_to_currency(row.spent_cents / 100.0) %>
                <% if row.over_budget %>
                  <span class="mt-1 block text-sm font-medium text-destructive"><%= t(".budget.exceeded") %></span>
                <% end %>
              <% end %>
            <% end %>
          </div>
          <p class="mt-4 text-sm text-muted-foreground">
            <%= t(".budget.total", value: number_to_currency(presenter.budget_total_cents / 100.0)) %>
          </p>
          <p class="mt-1 text-sm font-medium text-warning"><%= t(".simulated") %></p>
        <% end %>
      </section>
    </section>
    </div>
  </div>
</div>
