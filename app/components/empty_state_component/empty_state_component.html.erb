<%= tag.section(**html_attributes) do %>
  <%= render IconComponent.new(name: icon, size: :xl, classes: "text-muted-foreground") %>
  <h2 class="mt-4 text-section text-foreground"><%= title %></h2>
  <% if description.present? %>
    <p class="mt-2 max-w-md text-body text-muted-foreground"><%= description %></p>
  <% end %>
  <% if action? %>
    <div class="mt-6"><%= action %></div>
  <% end %>
<% end %>
