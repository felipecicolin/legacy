<%= tag.div(**html_attributes) do %>
  <% if empty_state? %>
    <%= render EmptyStateComponent.new(icon: "blueprint", title: t(".empty_title"),
                                       description: t(".empty_description")) %>
  <% else %>
    <div class="max-w-full overflow-x-auto">
      <table class="hidden min-w-full divide-y divide-border rounded-lg border border-border bg-card desktop:table">
        <caption class="sr-only"><%= caption %></caption>
        <thead class="bg-muted">
          <tr>
            <% columns.each do |column| %>
              <%= tag.th(**header_attributes(column)) { column_header(column) } %>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% @rows.each do |row| %>
            <tr class="hover:bg-muted">
              <% columns.each do |column| %>
                <%= tag.td(class: cell_classes(column)) { column_value(column, row) } %>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="space-y-4 desktop:hidden">
      <% @rows.each do |row| %>
        <dl class="rounded-lg border border-border bg-card p-4">
          <% columns.each do |column| %>
            <div class="flex items-start justify-between gap-4 border-b border-border py-3 first:pt-0 last:border-0 last:pb-0">
              <dt class="text-label text-muted-foreground"><%= column.header %></dt>
              <dd class="min-w-0 text-right <%= cell_classes(column) %>"><%= column_value(column, row) %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    </div>
  <% end %>
<% end %>
