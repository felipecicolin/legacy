<%= tag.div(**html_attributes) do %>
  <%= link_to t(".skip_to_content"), "#main-content",
              class: "sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 " \
                     "focus:rounded-sm focus:bg-primary focus:px-4 focus:py-3 focus:text-primary-foreground " \
                     "focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" %>

  <%# Sem `mx-auto max-w-7xl` aqui: centralizar o container INTEIRO empurrava a
      coluna de navegação para dentro da tela e abria faixa vazia dos dois
      lados. A largura de leitura é do conteúdo, não do shell. %>
  <div class="relative flex min-h-screen w-full">
    <aside id="app-shell-drawer"
           class="fixed inset-y-0 left-0 z-40 flex w-72 -translate-x-full flex-col bg-accent text-accent-foreground
                  p-5 shadow-lg transition-transform duration-200 ease-out desktop:static desktop:translate-x-0
                  desktop:shrink-0 desktop:shadow-none"
           data-app-shell-target="drawer"
           aria-label="<%= t(".navigation") %>">
      <%# O logotipo é imagem, e o nome acessível vem do `alt` — o mesmo
          `.brand` que antes era texto na tela, para o leitor de tela não
          perder a marca na troca. %>
      <%# Mesma altura da barra do topo, e centrado nos dois eixos: assim o
          logotipo assenta na faixa em vez de flutuar num canto dela. %>
      <div class="mb-6 flex h-16 items-center justify-center">
        <%= image_tag "logo.png", alt: t(".brand"), class: "h-8 w-auto brightness-0 invert" %>
      </div>

      <nav aria-label="<%= t(".navigation") %>" class="flex flex-1 flex-col gap-1">
        <%= navigation %>
      </nav>

      <%# Quem está usando o sistema fica visível no pé da coluna: é a
          convenção, e evita a dúvida de "em qual conta eu estou". %>
      <% if footer? %>
        <div class="mt-6 border-t border-accent-foreground/25 pt-4"><%= footer %></div>
      <% end %>
    </aside>

    <div class="fixed inset-0 z-30 -translate-x-full bg-foreground/20 transition-transform duration-200
               ease-out desktop:hidden"
         data-app-shell-target="overlay"
         data-action="click->app-shell#close"
         aria-hidden="true"></div>

    <div class="min-w-0 flex-1">
      <%# Só o disparador do menu mora aqui, e ele é de mobile: no desktop a
          barra seria uma faixa branca vazia. %>
      <header class="border-b border-border bg-card desktop:hidden">
        <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between px-4
                   tablet:px-5 desktop:px-6">
          <%= render ButtonComponent.new(size: :icon, classes: "desktop:hidden",
                                         aria: { expanded: false, controls: "app-shell-drawer" },
                                         data: { action: "click->app-shell#toggle keydown.enter->app-shell#toggle",
                                                 "app-shell-target": "toggle" }) do %>
            <%= render IconComponent.new(name: "menu", size: :sm) %>
            <span class="sr-only"><%= t(".open_navigation") %></span>
          <% end %>
          <div class="ml-auto"><%= content_for(:shell_header_actions) %></div>
        </div>
      </header>

      <main id="main-content" class="mx-auto grid w-full min-w-0 max-w-7xl grid-cols-4 gap-4 px-4 py-6
                                     tablet:grid-cols-8 tablet:gap-5 tablet:px-5 tablet:py-8
                                     desktop:grid-cols-12 desktop:gap-6 desktop:px-6">
        <div class="col-span-full min-w-0"><%= content %></div>
      </main>
    </div>
  </div>
<% end %>
