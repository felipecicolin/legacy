        {
          "name": "playground",
          "source": "  def playground(variant: :default, size: :md, disabled: false, label: \"Salvar alterações\")\n    render(ButtonComponent.new(label: label, variant: variant, size: size, disabled: disabled))\n  end"
        },
        {
          "name": "with_leading_icon",
          "source": "  def with_leading_icon\n    render(ButtonComponent.new(label: \"Adicionar\")) do |button|\n      button.with_leading_icon(name: \"plus\", size: :sm)\n    end"
