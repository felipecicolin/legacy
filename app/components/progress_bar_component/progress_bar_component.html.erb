<%= tag.div(**html_attributes) do %>
  <div class="mb-2 flex items-baseline justify-between gap-4">
    <span class="text-sm font-medium text-muted-foreground"><%= aria_label %></span>
    <span class="text-sm font-semibold text-foreground tabular-nums"><%= value_label %></span>
  </div>
  <%= tag.div(**progress_attributes) do %>
    <%= tag.div(**fill_attributes) %>
  <% end %>
<% end %>
