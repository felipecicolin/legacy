#!/usr/bin/env ruby
# frozen_string_literal: true

# Component registry generator.
#
# Introspects every ApplicationComponent subclass under app/components/ and
# emits two artifacts:
#
#   - app/components/registry.json    machine-readable schema (CI compares
#                                     this against the live tree on every PR)
#   - public/llms.txt                 markdown digest agents/LLMs read first
#
# Usage:
#   bin/components_registry            # regenerate both files
#   bin/components_registry --check    # exit 1 if files would change (CI)

require_relative "../config/environment"
require "json"
require "yaml"

REGISTRY_PATH = Rails.root.join("app/components/registry.json")
LLMS_PATH     = Rails.root.join("public/llms.txt")

def component_classes
  Rails.application.eager_load!
  ApplicationComponent.descendants.sort_by(&:name)
end

# Os previews vivem sob spec/, fora da árvore de autoload, então
# `Object.const_defined?` não os encontraria sozinho. Carregá-los aqui é o que
# faz a seção "Examples" do llms.txt existir.
def load_previews!
  Rails.root.glob("spec/components/previews/**/*_preview.rb").sort.each { |path| require path.to_s }
end

def constants_of(klass)
  own_constants = (klass.constants - ApplicationComponent.constants).sort
  own_constants.each_with_object({}) do |const, hash|
    value = klass.const_get(const)
    next unless value.is_a?(Array) || value.is_a?(Hash)

    hash[const.to_s] = value.is_a?(Hash) ? value.keys.map(&:to_s) : value.map(&:to_s)
  end
end

def initializer_params(klass)
  return [] unless klass.instance_method(:initialize).owner == klass

  klass.instance_method(:initialize).parameters.map do |type, name|
    { "name" => name.to_s, "kind" => type.to_s }
  end
end

def slot_names(klass)
  return [] unless klass.respond_to?(:registered_slots)

  klass.registered_slots.keys.map(&:to_s).sort
end

# Delega para o próprio componente em vez de reimplementar a regra: o
# identificador tem de ser exatamente o que o template escreve em
# `data: { controller: stimulus_controller }`, e duas implementações da mesma
# regra divergem na primeira vez que uma delas mudar.
def stimulus_identifier(klass)
  klass.allocate.stimulus_controller
end

# Duas formas: o template ao lado da classe
# (`app/components/foo_component.html.erb`) e o sidecar em diretório próprio
# (`app/components/foo_component/foo_component.html.erb`), que é o que o
# generator do ViewComponent produz quando há JS ou i18n junto.
def template_path_for(klass)
  name = klass.name.underscore
  candidates = ["app/components/#{name}.html.erb", "app/components/#{name}/#{name}.html.erb"]
  candidates.find { |rel| Rails.root.join(rel).exist? }
end

def preview_path_for(klass)
  rel = "spec/components/previews/#{klass.name.underscore}_preview.rb"
  Rails.root.join(rel).exist? ? rel : nil
end

def component_entry(klass)
  {
    "name" => klass.name,
    "category" => "ui",
    "params" => initializer_params(klass),
    "constants" => constants_of(klass),
    "slots" => slot_names(klass),
    "stimulus_controller" => stimulus_identifier(klass),
    "template" => template_path_for(klass),
    "preview" => preview_path_for(klass),
    "examples" => examples_for(klass),
  }
end

# Parse the component's *Preview class methods. Each public method is one
# canonical usage example AI agents can copy.
def examples_for(klass)
  preview_class_name = "#{klass.name}Preview"
  preview_path = preview_path_for(klass)
  return [] unless preview_path

  return [] unless Object.const_defined?(preview_class_name)

  preview_class = Object.const_get(preview_class_name)
  preview_class.instance_methods(false).sort.map do |method_name|
    {
      "name" => method_name.to_s,
      "source" => method_source(preview_class, method_name),
    }
  end
end

def method_source(klass, method_name)
  file, start_line = klass.instance_method(method_name).source_location
  return nil unless file && File.exist?(file)

  lines = File.readlines(file)
  body = []
  depth = 0
  lines[(start_line - 1)..].each do |line|
    body << line
    depth += line.count("{") - line.count("}")
    depth += line.scan(/\bdo\b/).size - line.scan(/\bend\b/).size
    break if body.size > 1 && depth <= 0 && line.strip == "end"
  end
  body.join.rstrip
end

def render_llms_txt(entries)
  out = +"# Components registry\n\n"
  out << "Source of truth for UI components. Regenerated by `bin/components_registry`.\n"
  out << "**NEVER hand-edit this file.** Re-run the script after changing any component.\n\n"

  entries.each do |entry|
    out << "## #{entry['name']}\n\n"
    out << "- **Stimulus controller:** `#{entry['stimulus_controller']}`\n" if entry["stimulus_controller"]
    out << "- **Template:** `#{entry['template']}`\n" if entry["template"]
    out << "- **Preview:** `#{entry['preview']}`\n" if entry["preview"]

    unless entry["params"].empty?
      out << "- **Params:**\n"
      entry["params"].each { |p| out << "  - `#{p['name']}` (#{p['kind']})\n" }
    end

    entry["constants"].each do |name, values|
      out << "- **#{name}:** #{values.map { |v| "`#{v}`" }.join(', ')}\n"
    end

    unless entry["slots"].empty?
      out << "- **Slots:** #{entry['slots'].map { |s| "`#{s}`" }.join(', ')}\n"
    end

    if entry["examples"].any?
      out << "- **Examples:**\n\n"
      entry["examples"].each do |example|
        out << "  - `#{example['name']}`:\n\n"
        out << "    ```ruby\n"
        example["source"].to_s.lines.each { |line| out << "    #{line}" }
        out << "\n    ```\n\n"
      end
    end

    out << "\n"
  end

  out
end

def write_or_check(path, contents, check_mode:)
  current = path.exist? ? path.read : nil

  if check_mode
    return true if current == contents

    warn "REGISTRY DRIFT: #{path.relative_path_from(Rails.root)} is out of date. Run bin/components_registry."
    false
  else
    path.parent.mkpath
    path.write(contents)
    puts "wrote #{path.relative_path_from(Rails.root)}"
    true
  end
end

check_mode = ARGV.include?("--check")
load_previews!
entries    = component_classes.map { |klass| component_entry(klass) }

registry_json = JSON.pretty_generate({ "components" => entries }) + "\n"
llms_txt      = render_llms_txt(entries)

ok = [
  write_or_check(REGISTRY_PATH, registry_json, check_mode: check_mode),
  write_or_check(LLMS_PATH, llms_txt, check_mode: check_mode),
].all?

exit(ok ? 0 : 1)
